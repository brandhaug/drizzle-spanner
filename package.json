{
  "name": "drizzle-spanner",
  "version": "0.1.0",
  "description": "Google Cloud Spanner (GoogleSQL) dialect for Drizzle ORM v1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandhaug/drizzle-spanner.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./migrator": {
      "types": "./dist/migrator.d.ts",
      "import": "./dist/migrator.js",
      "default": "./dist/migrator.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "default": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "check:fix": "npm run lint:fix && npm run format",
    "test": "vitest run tests/unit packages/drizzle-spanner-kit/tests/unit",
    "check:types": "attw --pack . --profile esm-only && attw --pack packages/drizzle-spanner-kit --profile esm-only",
    "check:pack": "node scripts/check-pack.ts",
    "test:integration": "vitest run tests/integration packages/drizzle-spanner-kit/tests/integration --fileParallelism=false",
    "test:integration:bun": "bun test tests/integration packages/drizzle-spanner-kit/tests/integration --timeout 180000",
    "emulator:up": "docker compose up -d",
    "emulator:down": "docker compose down",
    "emulator:bootstrap": "node scripts/emulator-bootstrap.ts",
    "emulator:smoke": "node scripts/emulator-smoke.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@google-cloud/spanner": "catalog:",
    "@types/node": "catalog:",
    "drizzle-orm": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@google-cloud/spanner": ">=7.0.0",
    "drizzle-orm": ">=1.0.0-beta.22 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@google-cloud/spanner": {
      "optional": true
    }
  },
  "overrides": {
    "drizzle-spanner": "file:."
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=20"
  },
  "packageManager": "bun@1.4.0",
  "catalog": {
    "@arethetypeswrong/cli": "0.18.5",
    "@google-cloud/spanner": "8.10.0",
    "@types/node": "24.13.3",
    "drizzle-orm": "1.0.0-beta.22",
    "lint-staged": "17.2.0",
    "oxfmt": "0.57.0",
    "oxlint": "1.76.0",
    "testcontainers": "11.14.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}

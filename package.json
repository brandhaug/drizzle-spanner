{
  "name": "drizzle-spanner",
  "version": "0.1.0",
  "description": "Google Cloud Spanner (GoogleSQL) dialect for Drizzle ORM v1",
  "keywords": [
    "drizzle",
    "google-cloud",
    "spanner",
    "typescript"
  ],
  "homepage": "https://github.com/brandhaug/drizzle-spanner#readme",
  "bugs": {
    "url": "https://github.com/brandhaug/drizzle-spanner/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandhaug/drizzle-spanner.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./migrator": {
      "types": "./dist/migrator.d.ts",
      "import": "./dist/migrator.js",
      "default": "./dist/migrator.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "default": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix --type-aware",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "check:fix": "npm run lint:fix && npm run format",
    "test": "bun test tests/unit packages/drizzle-spanner-kit/tests/unit",
    "check:types": "attw --pack . --profile esm-only && attw --pack packages/drizzle-spanner-kit --profile esm-only",
    "check:pack": "node scripts/check-pack.ts",
    "test:integration": "bun test tests/integration packages/drizzle-spanner-kit/tests/integration --timeout 180000",
    "test:integration:bun": "bun test tests/integration packages/drizzle-spanner-kit/tests/integration --timeout 180000",
    "emulator:up": "docker compose up -d",
    "emulator:down": "docker compose down",
    "emulator:bootstrap": "node scripts/emulator-bootstrap.ts",
    "emulator:smoke": "node scripts/emulator-smoke.ts",
    "prepare": "git config core.hooksPath .githooks",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@google-cloud/spanner": "catalog:",
    "@types/bun": "1.4.0",
    "@types/node": "catalog:",
    "drizzle-orm": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "peerDependencies": {
    "@google-cloud/spanner": ">=7.0.0",
    "drizzle-orm": ">=1.0.0-rc.4 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@google-cloud/spanner": {
      "optional": true
    }
  },
  "overrides": {
    "@opentelemetry/core@<2.8.0": "2.8.0",
    "drizzle-spanner": "file:.",
    "uuid@<11.1.1": "11.1.1"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@arethetypeswrong/cli": "0.18.5",
    "@google-cloud/spanner": "8.11.0",
    "@types/node": "26.4.1",
    "drizzle-orm": "1.0.0-rc.4",
    "lint-staged": "17.5.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "testcontainers": "12.1.0",
    "typescript": "7.0.2",
    "ultracite": "7.11.0"
  }
}

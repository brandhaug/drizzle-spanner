  "description": "Migration CLI for drizzle-spanner: generate, migrate, pull and push against Google Cloud Spanner (GoogleSQL)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandhaug/drizzle-spanner.git",
    "directory": "packages/drizzle-spanner-kit"
  },
  "bin": {
    "drizzle-spanner-kit": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
